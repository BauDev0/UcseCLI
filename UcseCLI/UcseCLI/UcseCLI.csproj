<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ucse</ToolCommandName>
    <PackageId>UcseCLI</PackageId>
    <Version>2.1.0</Version>
    <Authors>Bautista</Authors>
    <Description>
      Herramienta de línea de comandos que automatiza el armado de proyectos de
      Programación 1 (UCSE): soluciones por capas, Web API, frontend y archivos
      .cs con código de ejemplo para adaptar.
    </Description>
    <PackageTags>ucse;programacion1;dotnet;cli;scaffolding;nunit;webapi</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/BauDev0/UcseCLI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

  <ItemGroup>
    <!-- README del repositorio, usado como portada del paquete en NuGet. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
