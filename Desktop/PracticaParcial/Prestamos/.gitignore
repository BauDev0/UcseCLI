x64/
x86/
[Ll]og/
[Ll]ogs/
artifacts/

# Paquetes NuGet
*.nupkg
*.snupkg
packages/

# Archivos de usuario de Visual Studio / Rider / VS Code
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.vscode/
.idea/
*.DotSettings.user

# Resultados de tests y cobertura
[Tt]est[Rr]esult*/
coverage*.json
coverage*.xml
*.coverage
*.trx

# Variables de entorno y secretos
.env
appsettings.*.local.json

# Sistema operativo
.DS_Store
Thumbs.db
